\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Top: Time evolution of the main energy components computed for disk-identified particles: rotational kinetic energy $E_\mathrm  {rot}$ (yellow), turbulent kinetic energy $E_\mathrm  {turb}$ (cyan), total kinetic energy $E_\mathrm  {kin} = E_\mathrm  {rot} + E_\mathrm  {turb}$ (green), gravitational potential energy $|E_\mathrm  {pot}|$ (red), thermal energy $E_\mathrm  {therm}$ (orange), and magnetic energy $E_\mathrm  {mag}$ (magenta). \\ Bottom: pure kinematic virial ratio $2 E_\mathrm  {kin}/|E_\mathrm  {pot}|$ (black); virial ratio with added thermal component (orange), and with added thermal and magnetic components (purple). The dashed red line marks virial equilibrium ($= 1$). The disk starts sub-virial and reaches equilibrium by $\sim 2\,\mathrm  {kyr}$. The inclusion of thermal energy reveals that the disk is thermally supported and near virial equilibrium at all times. Magnetic energy provides negligible additional support to the virial ratio. }}{7}{figure.4}\protected@file@percent }
\newlabel{fig:energy_evol}{{4}{7}{Top: Time evolution of the main energy components computed for disk-identified particles: rotational kinetic energy $E_\mathrm {rot}$ (yellow), turbulent kinetic energy $E_\mathrm {turb}$ (cyan), total kinetic energy $E_\mathrm {kin} = E_\mathrm {rot} + E_\mathrm {turb}$ (green), gravitational potential energy $|E_\mathrm {pot}|$ (red), thermal energy $E_\mathrm {therm}$ (orange), and magnetic energy $E_\mathrm {mag}$ (magenta). \\ Bottom: pure kinematic virial ratio $2 E_\mathrm {kin}/|E_\mathrm {pot}|$ (black); virial ratio with added thermal component (orange), and with added thermal and magnetic components (purple). The dashed red line marks virial equilibrium ($= 1$). The disk starts sub-virial and reaches equilibrium by $\sim 2\kyr $. The inclusion of thermal energy reveals that the disk is thermally supported and near virial equilibrium at all times. Magnetic energy provides negligible additional support to the virial ratio}{figure.4}{}}
