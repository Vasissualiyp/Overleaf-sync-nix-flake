\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Phase diagram (temperature and H$_2$ fraction vs.\ number density) at three representative epochs: pre-stellar ($t - t_1\approx -0.5\,\mathrm  {kyr}$, left), first sink formation ($t - t_1= 0$, middle), and post-first-sink ($t - t_1= 1.2\,\mathrm  {kyr}$, right). Green points correspond to disk-identified particles, red points correspond to points in our cutout simulation that have not been identified as disk, and blue points correspond to points in the full-box simulation right before the cutout was applied (only included in the leftmost plots). $f_{\rm  H_2}=0$ for most of particles in the low-density region (blue particles), thus missing from the bottom-left panel. \added {Solid black curves show the zero-metallicity Population~III collapse track (\citet  {omukai00}, as digitized by \citet  {klessen_glover23}) on the temperature (top) and H$_2$ fraction (bottom) panels. Coloured curves with shaded bands are binned medians of the simulated gas (the bands span $\pm 1\sigma $): blue is the instantaneous median at the pre-stellar epoch; dark red is the mean of the per-snapshot medians over $-0.5\,\mathrm  {kyr} \le t - t_1\le 0$, and dark blue over $0 \le t - t_1\le 1.2\,\mathrm  {kyr}$.}}}{7}{figure.3}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Solid black curves show the zero-metallicity Population~III collapse track (\citet  {omukai00}, as digitized by \citet  {klessen_glover23}) on the temperature (top) and H$_2$ fraction (bottom) panels. Coloured curves with shaded bands are binned medians of the simulated gas (the bands span $\pm 1\sigma $): blue is the instantaneous median at the pre-stellar epoch; dark red is the mean of the per-snapshot medians over $-0.5\,\mathrm  {kyr} \le t - t_1\le 0$, and dark blue over $0 \le t - t_1\le 1.2\,\mathrm  {kyr}$.}}{7}{section*.5}\protected@file@percent }
\newlabel{fig:phases}{{3}{7}{Phase diagram (temperature and H$_2$ fraction vs.\ number density) at three representative epochs: pre-stellar ($t - \tform \approx -0.5\kyr $, left), first sink formation ($t - \tform = 0$, middle), and post-first-sink ($t - \tform = 1.2\kyr $, right). Green points correspond to disk-identified particles, red points correspond to points in our cutout simulation that have not been identified as disk, and blue points correspond to points in the full-box simulation right before the cutout was applied (only included in the leftmost plots). $f_{\rm H_2}=0$ for most of particles in the low-density region (blue particles), thus missing from the bottom-left panel. \added {Solid black curves show the zero-metallicity Population~III collapse track (\citet {omukai00}, as digitized by \citet {klessen_glover23}) on the temperature (top) and H$_2$ fraction (bottom) panels. Coloured curves with shaded bands are binned medians of the simulated gas (the bands span $\pm 1\sigma $): blue is the instantaneous median at the pre-stellar epoch; dark red is the mean of the per-snapshot medians over $-0.5\,\mathrm {kyr} \le t - \tform \le 0$, and dark blue over $0 \le t - \tform \le 1.2\,\mathrm {kyr}$.}}{section*.5}{}}
