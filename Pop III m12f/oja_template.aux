\newlabel{fig:zoom}{{2}{6}{Multi-scale density projection of the simulation at $t - \tform \approx 15 \kyr $, illustrating the dynamic range from the cosmic web (box size of $ \approx 100 \kpc $) to the center of the protostellar disk (resolving AU scales). White boxes mark the region shown in the next panel. White star symbols mark sink particles}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Phase diagram (temperature and H$_2$ fraction vs.\ number density) at three representative epochs: pre-stellar ($t - t_1\approx -0.5\,\mathrm  {kyr}$, left), first sink formation ($t - t_1= 0$, middle), and post-first-sink ($t - t_1= 1.2\,\mathrm  {kyr}$, right). Green points correspond to disk-identified particles, red points correspond to points in our cutout simulation that have not been identified as disk, and blue points correspond to points in the full-box simulation right before the cutout was applied (only included in the leftmost plots). $f_{\rm  H_2}=0$ for most of particles in the low-density region (blue particles), thus missing from the bottom-left panel. The dashed curves in the temperature panels show the theoretical $T$--$n$ tracks for primordial ($Z=0$) and metal-enriched ($Z=10^{-4}\,Z_\odot $) gas from \citet  {klessen_glover23} (KG23); shaded bands indicate the median $\pm $ standard deviation of the fits over the time intervals $-0.5\,\mathrm  {kyr} \le t - t_1\le 0$ (middle) and $0 \le t - t_1\le 1.2\,\mathrm  {kyr}$ (right), respectively.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:phases}{{3}{6}{Phase diagram (temperature and H$_2$ fraction vs.\ number density) at three representative epochs: pre-stellar ($t - \tform \approx -0.5\kyr $, left), first sink formation ($t - \tform = 0$, middle), and post-first-sink ($t - \tform = 1.2\kyr $, right). Green points correspond to disk-identified particles, red points correspond to points in our cutout simulation that have not been identified as disk, and blue points correspond to points in the full-box simulation right before the cutout was applied (only included in the leftmost plots). $f_{\rm H_2}=0$ for most of particles in the low-density region (blue particles), thus missing from the bottom-left panel. The dashed curves in the temperature panels show the theoretical $T$--$n$ tracks for primordial ($Z=0$) and metal-enriched ($Z=10^{-4}\,Z_\odot $) gas from \citet {klessen_glover23} (KG23); shaded bands indicate the median $\pm $ standard deviation of the fits over the time intervals $-0.5\,\mathrm {kyr} \le t - \tform \le 0$ (middle) and $0 \le t - \tform \le 1.2\,\mathrm {kyr}$ (right), respectively}{figure.3}{}}
