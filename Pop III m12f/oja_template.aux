\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Top: Time evolution of the main energy components computed for disk-identified particles \added {(the disk radius $r_{\mathrm  {disk}}$ is taken as the 90th-percentile cylindrical radius of disk-identified particles, see \autoref {sec:disk})}: rotational kinetic energy $E_\mathrm  {rot}$ (blue), turbulent kinetic energy $E_\mathrm  {turb}$ (green), total kinetic energy $E_\mathrm  {kin} = E_\mathrm  {rot} + E_\mathrm  {turb}$ (black, dash-dotted), gravitational potential energy $|E_\mathrm  {pot}|$ (red), thermal energy $E_\mathrm  {therm}$ (orange, dotted), and magnetic energy $E_\mathrm  {mag}$ (magenta, dashed). \\ Bottom: pure kinematic virial ratio $\alpha _{\text  {kin}} = 2 E_\mathrm  {kin}/|E_\mathrm  {pot}|$ (black); virial ratio with added thermal component (orange, dashed) $\alpha _{\text  {kin+th}} = 2 \left ( E_\mathrm  {kin} + E_\mathrm  {therm} \right )/|E_\mathrm  {pot}|$ , and with added thermal and magnetic components (purple, dash-dotted), $\alpha _{\text  {vir}} = 2 \left ( E_\mathrm  {kin} + E_\mathrm  {therm} + E_\mathrm  {mag} \right )/|E_\mathrm  {pot}|$ . The dotted red line marks virial equilibrium ($= 1$). The disk starts sub-virial and reaches equilibrium by $\sim 2\,\mathrm  {kyr}$. The inclusion of thermal energy reveals that the disk is thermally supported and near virial equilibrium at all times. Magnetic energy provides negligible additional support to the virial ratio. }}{8}{figure.4}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{(the disk radius $r_{\mathrm  {disk}}$ is taken as the 90th-percentile cylindrical radius of disk-identified particles, see \autoref {sec:disk})}}{8}{section*.6}\protected@file@percent }
\newlabel{fig:energy_evol}{{4}{8}{Top: Time evolution of the main energy components computed for disk-identified particles \added {(the disk radius $r_{\mathrm {disk}}$ is taken as the 90th-percentile cylindrical radius of disk-identified particles, see \autoref {sec:disk})}: rotational kinetic energy $E_\mathrm {rot}$ (blue), turbulent kinetic energy $E_\mathrm {turb}$ (green), total kinetic energy $E_\mathrm {kin} = E_\mathrm {rot} + E_\mathrm {turb}$ (black, dash-dotted), gravitational potential energy $|E_\mathrm {pot}|$ (red), thermal energy $E_\mathrm {therm}$ (orange, dotted), and magnetic energy $E_\mathrm {mag}$ (magenta, dashed). \\ Bottom: pure kinematic virial ratio $\alpha _{\text {kin}} = 2 E_\mathrm {kin}/|E_\mathrm {pot}|$ (black); virial ratio with added thermal component (orange, dashed) $\alpha _{\text {kin+th}} = 2 \left ( E_\mathrm {kin} + E_\mathrm {therm} \right )/|E_\mathrm {pot}|$ , and with added thermal and magnetic components (purple, dash-dotted), $\alpha _{\text {vir}} = 2 \left ( E_\mathrm {kin} + E_\mathrm {therm} + E_\mathrm {mag} \right )/|E_\mathrm {pot}|$ . The dotted red line marks virial equilibrium ($= 1$). The disk starts sub-virial and reaches equilibrium by $\sim 2\kyr $. The inclusion of thermal energy reveals that the disk is thermally supported and near virial equilibrium at all times. Magnetic energy provides negligible additional support to the virial ratio}{section*.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Disk evolution}{8}{subsection.3.2}\protected@file@percent }
