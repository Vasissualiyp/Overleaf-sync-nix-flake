\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces  Evolution of phase plot of magnitude of magnetic field $\left | B \right |$ vs number density $n$. Solid lines correspond to median profiles at different times, with the shaded regions being 90-th percentile of all the particles. $\alpha $ corresponds to the exponent in power-law fit $ \left | B \right | \propto n^\alpha $. $\left | B \right |$ spans 3 orders of magnitude at the point of first sink formation, and up to 4 orders of magnitude at later times. {\textcolor {darkgreen}{[SK: Fix this figure]}}}}{16}{figure.13}\protected@file@percent }
\newlabel{fig:phase_Bfield}{{13}{16}{Evolution of phase plot of magnitude of magnetic field $\left | B \right |$ vs number density $n$. Solid lines correspond to median profiles at different times, with the shaded regions being 90-th percentile of all the particles. $\alpha $ corresponds to the exponent in power-law fit $ \left | B \right | \propto n^\alpha $. $\left | B \right |$ spans 3 orders of magnitude at the point of first sink formation, and up to 4 orders of magnitude at later times. \skcomment {Fix this figure}}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Dimensionless mass-to-flux ratio $\mu _\Phi $ as a function of radius at six epochs. The dashed line marks the critical value $\mu _\Phi = 1$. The disk evolves from highly supercritical ($\mu _\Phi \sim 100$--$300$) at early times to partially subcritical ($\mu _\Phi < 1$) at some inner radii by $9.5\,\mathrm  {kyr}$. }}{16}{figure.14}\protected@file@percent }
\newlabel{fig:profile_mf}{{14}{16}{Dimensionless mass-to-flux ratio $\mu _\Phi $ as a function of radius at six epochs. The dashed line marks the critical value $\mu _\Phi = 1$. The disk evolves from highly supercritical ($\mu _\Phi \sim 100$--$300$) at early times to partially subcritical ($\mu _\Phi < 1$) at some inner radii by $9.5\kyr $}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Top: time evolution of the stellar mass (all sinks; orange), disk gas mass (cyan solid), gas within a $0.1$ pc aperture (cyan dashed), and total mass (disk + stars, grey solid; aperture + stars, grey). The best-fit power law $M_* \propto t^{2.08}$ is shown as a dashed red line; the reference $t^2$ scaling as a dotted pink line. Bottom: star formation efficiency $f_*$ within the disk (green solid) and within the $0.1$ pc aperture (green dashed). }}{17}{figure.15}\protected@file@percent }
\newlabel{fig:mass_evol}{{15}{17}{Top: time evolution of the stellar mass (all sinks; orange), disk gas mass (cyan solid), gas within a $0.1$ pc aperture (cyan dashed), and total mass (disk + stars, grey solid; aperture + stars, grey). The best-fit power law $M_* \propto t^{2.08}$ is shown as a dashed red line; the reference $t^2$ scaling as a dotted pink line. Bottom: star formation efficiency $f_*$ within the disk (green solid) and within the $0.1$ pc aperture (green dashed)}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Evolution of masses of individual sinks. Dashed line represents ideal $M_{*} \propto t^2$ law, which is being followed for total mass of all the sinks (black line). At earlier times, before the first bulk star formation event at 2-3 kyr, all of stellar mass is concentrated in the 2 central sinks (top blue lines). These massive sinks reach mass of around $20 M_\odot $ by the 15 kyr mark, with their accretion slowing down compared to less massive sinks, which still accrete rapidly. }}{17}{figure.16}\protected@file@percent }
\newlabel{fig:mass_evol_individual}{{16}{17}{Evolution of masses of individual sinks. Dashed line represents ideal $M_{*} \propto t^2$ law, which is being followed for total mass of all the sinks (black line). At earlier times, before the first bulk star formation event at 2-3 kyr, all of stellar mass is concentrated in the 2 central sinks (top blue lines). These massive sinks reach mass of around $20 M_\odot $ by the 15 kyr mark, with their accretion slowing down compared to less massive sinks, which still accrete rapidly}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Top: stellar accretion rate (magenta) and gas depletion rate within the aperture (cyan dashed). Bottom: sphere of influence radius $r_\mathrm  {SOI}$ ($M_\mathrm  {gas,enc} = M_*$; orange), growing from $\sim 80\,\mathrm  {AU}$ to $\sim 10^4\,\mathrm  {AU}$ over the simulation. }}{17}{figure.17}\protected@file@percent }
\newlabel{fig:mass_evol_rates}{{17}{17}{Top: stellar accretion rate (magenta) and gas depletion rate within the aperture (cyan dashed). Bottom: sphere of influence radius $r_\mathrm {SOI}$ ($M_\mathrm {gas,enc} = M_*$; orange), growing from $\sim 80\AU $ to $\sim 10^4\AU $ over the simulation}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Time evolution of the number of sinks in the simulation. The dashed line shows a $N \propto t^{1.5}$ power law for comparison \citep  {li_klein_mckee18}. Bulk star formation events in the spiral arms (visible in the bottom panels of \autoref {fig:toomre_Q_merged}) are seen to rapidly increase the number of sinks at $t - t_1 \approx 3$--$4\,\mathrm  {kyr}$ and $7$--$8\,\mathrm  {kyr}$.}}{17}{figure.18}\protected@file@percent }
\newlabel{fig:num_sinks}{{18}{17}{Time evolution of the number of sinks in the simulation. The dashed line shows a $N \propto t^{1.5}$ power law for comparison \citep {li_klein_mckee18}. Bulk star formation events in the spiral arms (visible in the bottom panels of \autoref {fig:toomre_Q_merged}) are seen to rapidly increase the number of sinks at $t - t_1 \approx 3$--$4\,\mathrm {kyr}$ and $7$--$8\,\mathrm {kyr}$}{figure.18}{}}
